  "technical_routes": [
    {
      "name": "auth_callback",
      "route": "/auth/callback",
      "type": "route_handler",
      "counted_as_screen": false,
      "note": "Supabase Auth 이메일 인증/OAuth 콜백 처리 전용 기술 Route"
    },
    {
      "name": "api_routes",
      "route": "/api/*",
      "type": "route_handler",
      "counted_as_screen": false,
      "note": "동행 CRUD, 참가 요청, 신고·차단, 관리자 신고 처리, 외부 URL 설정 등 서버 액션/Route Handler. 항공·숙소 폼은 서버 API를 만들지 않는다."
    },
    {
      "name": "not_found",
      "route": "*",
      "page_entry": "src/app/not-found.tsx",
      "type": "error_page",
      "counted_as_screen": false,
      "note": "404 처리, 홈/이전/재시도 중 최소 1개 복구 행동 제공"
    },
    {
      "name": "error_boundary",
      "route": "*",
      "page_entry": "src/app/error.tsx",
      "type": "error_page",
      "counted_as_screen": false,
      "note": "500/런타임 오류 처리, 재시도 행동 제공"
    }
  ],
